    {
      "id": "global_result",
      "type": "text",
      "x": 650,
      "y": 883,
      "width": 1320,
      "height": 75,
      "fontSize": 20,
      "strokeColor": "#374151",
      "text": "Multi-AZ resilience remains in EACH Region. Cross-Region replicas add another failure boundary.\nYour application must route or fail over to the healthy Region.\nMREC can return stale remote data; concurrent updates use last-writer-wins resolution.",
      "seed": 300053,
      "angle": 0,
      "backgroundColor": "transparent",
      "fillStyle": "solid",
