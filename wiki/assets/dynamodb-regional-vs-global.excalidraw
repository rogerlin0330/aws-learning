      "x": 675,
      "y": 1008,
      "width": 1260,
      "height": 71.25,
      "fontSize": 19,
      "strokeColor": "#22c55e",
      "text": "PutItem Orders: {OrderId: \"O-123\", Status: \"PAID\"}\nMREC: write succeeds in us-east-1, then propagates to us-west-2.\nA GetItem in us-west-2 can briefly return the previous committed value.",
      "seed": 400008,
      "angle": 0,
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
